# =============================================================================
# EchoCoach — Environment Variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# --- LiveKit ---
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Rime TTS (primary spoken output) ---
RIME_API_KEY=your_rime_api_key
# Pinned voice config used in prod (see agent/echocoach/main.py)
# RIME_MODEL=coda
# RIME_VOICE=celeste
# RIME_LANG=eng

# --- Deepgram STT ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Pronunciation scoring: free on-device engine, no key needed ---
# Uses pronounce-assess (wav2vec2). First run downloads ~1.2GB model
# to the HuggingFace cache. Needs ffmpeg installed on the machine.
# Never copy RIME_API_KEY or DEEPGRAM_API_KEY into web/.env.local.
# web/.env.local must contain only LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET.
